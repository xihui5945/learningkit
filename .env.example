# Copy to .env.local (git-ignored) and fill in. Never commit real keys.
# Azure portal → your Speech resource → "Keys and Endpoint".
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southeastasia
# Optional: any en-US neural voice. Jenny was chosen by ear for clear vowels and voiced stops.
AZURE_SPEECH_VOICE=en-US-JennyNeural
